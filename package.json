{
  "name": "firefox-use",
  "version": "0.2.0",
  "description": "Computer use for Firefox: an MCP server that gives Claude Code the same browser tool surface it has for Chrome, driven over WebDriver BiDi. No dependencies.",
  "bin": {
    "firefox-use": "bin/firefox-use"
  },
  "main": "src/tools.js",
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:integration": "FIREFOX_USE_IT=1 node --test test/*.test.js",
    "spec": "node scripts/extract-chrome-spec.js",
    "sync-plugin": "node scripts/sync-plugin.js",
    "start": "node bin/firefox-use mcp"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "keywords": [
    "mcp",
    "claude",
    "claude-code",
    "firefox",
    "browser-automation",
    "webdriver-bidi",
    "computer-use",
    "model-context-protocol"
  ],
  "homepage": "https://github.com/leetomo2528/firefox-use#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leetomo2528/firefox-use.git"
  },
  "bugs": {
    "url": "https://github.com/leetomo2528/firefox-use/issues"
  },
  "author": "Yunje Lee",
  "type": "commonjs",
  "files": [
    "bin/",
    "src/",
    "skills/",
    "scripts/extract-chrome-spec.js",
    "docs/PARITY.md",
    "README.md",
    "LICENSE",
    "NOTICE"
  ]
}
