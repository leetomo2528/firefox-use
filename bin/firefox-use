#!/usr/bin/env node
'use strict';
// firefox-use - the Claude-in-Chrome tool surface, driving Firefox over WebDriver BiDi.

const fs = require('fs');
const os = require('os');
const path = require('path');
const { spawnSync } = require('child_process');
const launcher = require('../src/launcher');
const { McpServer } = require('../src/mcp');
const { Session } = require('../src/session');
const pkg = require('../package.json');

const args = process.argv.slice(2);
const command = args[0] && !args[0].startsWith('-') ? args.shift() : 'mcp';

function flag(name) {
  const i = args.indexOf(`--${name}`);
  if (i === -1) return undefined;
  const next = args[i + 1];
  return next && !next.startsWith('--') ? next : true;
}

const options = {
  headless: flag('headless') === true || process.env.FIREFOX_USE_HEADLESS === '1',
  port: flag('port') ? Number(flag('port')) : undefined,
  profile: typeof flag('profile') === 'string' ? path.resolve(flag('profile')) : undefined,
};

const HELP = `firefox-use ${pkg.version} - drive Firefox from Claude Code

Usage: firefox-use <command> [options]

Commands:
  mcp                 Run the MCP server on stdio (default; this is what Claude Code starts)
  start [url]         Launch Firefox with WebDriver BiDi enabled
  stop                Quit the Firefox instance started by firefox-use
  restart             Stop and start again, clearing a stale automation session
  status              Show whether Firefox is running, plus this session's tabs
  open <url>          Open a URL in the running instance (starting it if needed)
  shot <file> [url]   Save a screenshot to a PNG file (--full for the whole page)
  install             Register with Claude Code as claude-in-firefox (claude mcp add)
  install-skill       Install the claude-in-firefox skill into ~/.claude/skills
  doctor              Check Firefox, the profile, the port and the BiDi handshake

Options:
  --headless          Run Firefox without a window
  --port <n>          BiDi port (default 9222, or $FIREFOX_USE_PORT)
  --profile <dir>     Firefox profile directory (default ~/.firefox-use/profile)
`;

async function withSession(fn) {
  const session = await Session.open(options);
  try {
    return await fn(session);
  } finally {
    await session.close();
  }
}

async function main() {
  switch (command) {
    case 'mcp': {
      const { ToolHost } = require('../src/tools');
      const host = new ToolHost(options);
      const server = new McpServer({
        name: 'firefox-use',
        version: pkg.version,
        tools: host.tools(),
        onShutdown: () => host.close(),
      });
      server.start();
      server.log(`ready - ${host.tools().length} tools, firefox ${launcher.findFirefox() || 'NOT FOUND'}`);
      return new Promise(() => {}); // run until stdin closes or a signal arrives
    }

    case 'start': {
      const url = args.find((a) => !a.startsWith('--'));
      const state = await launcher.ensureRunning({ ...options, url });
      console.log(`Firefox ${state.launched ? 'started' : 'already running'}: pid ${state.pid}, port ${state.port}`);
      console.log(`profile: ${state.profile}`);
      return;
    }

    case 'stop': {
      const stopped = await launcher.stop();
      console.log(stopped ? 'Firefox stopped.' : 'Nothing to stop.');
      return;
    }

    case 'restart': {
      await launcher.stop();
      await new Promise((r) => setTimeout(r, 1000));
      const state = await launcher.launch(options);
      console.log(`Firefox restarted: pid ${state.pid}, port ${state.port}`);
      return;
    }

    case 'status': {
      const st = await launcher.status();
      console.log(`firefox: ${st.reachable ? 'running' : 'not running'} (pid ${st.pid ?? '-'}, port ${st.port})`);
      console.log(`profile: ${st.profile}`);
      console.log(`log:     ${st.logFile}`);
      if (!st.reachable) return;
      await withSession(async (session) => {
        const tabs = await session.listTabs();
        console.log('tabs:');
        for (const tab of tabs) console.log(`  [${tab.tabId}] ${tab.url}`);
      });
      return;
    }

    case 'open': {
      const url = args.find((a) => !a.startsWith('--'));
      if (!url) throw new Error('usage: firefox-use open <url>');
      await withSession(async (session) => {
        const tabId = await session.defaultTabId();
        const target = /^[a-z][a-z0-9+.-]*:/i.test(url) ? url : `https://${url}`;
        const res = await session.navigate(tabId, target);
        console.log(`Loaded ${res.url} in tab ${tabId}`);
      });
      return;
    }

    case 'shot': {
      const positional = args.filter((a) => !a.startsWith('--'));
      const file = positional[0];
      if (!file) throw new Error('usage: firefox-use shot <file.png> [url]');
      await withSession(async (session) => {
        const tabId = await session.defaultTabId();
        if (positional[1]) {
          const target = /^[a-z][a-z0-9+.-]*:/i.test(positional[1]) ? positional[1] : `https://${positional[1]}`;
          await session.navigate(tabId, target);
        }
        const shot = await session.screenshot(tabId, { fullPage: flag('full') === true });
        fs.writeFileSync(file, Buffer.from(shot.data, 'base64'));
        console.log(`Saved ${file}`);
      });
      return;
    }

    case 'install': {
      const entry = path.resolve(__dirname, 'firefox-use');
      const scope = typeof flag('scope') === 'string' ? flag('scope') : 'user';
      // Registering under this name makes the tools read as
      // mcp__claude-in-firefox__computer, one word away from Chrome's.
      const name = typeof flag('name') === 'string' ? flag('name') : 'claude-in-firefox';
      spawnSync('claude', ['mcp', 'remove', 'firefox', '--scope', scope], { stdio: 'ignore' });
      const res = spawnSync('claude', ['mcp', 'add', name, '--scope', scope, '--', process.execPath, entry, 'mcp'], {
        stdio: 'inherit',
      });
      if (res.error) throw new Error(`could not run claude: ${res.error.message}`);
      if (res.status !== 0) throw new Error(`claude mcp add exited with ${res.status}`);
      console.log('\nRegistered. Run `firefox-use install-skill`, then start a new Claude Code session.');
      return;
    }

    case 'install-skill': {
      const src = path.resolve(__dirname, '..', 'skills', 'claude-in-firefox');
      const dest = path.join(os.homedir(), '.claude', 'skills', 'claude-in-firefox');
      if (!fs.existsSync(src)) throw new Error(`skill source missing: ${src}`);
      fs.mkdirSync(dest, { recursive: true });
      for (const entry of fs.readdirSync(src)) {
        fs.copyFileSync(path.join(src, entry), path.join(dest, entry));
      }
      console.log(`Installed the claude-in-firefox skill to ${dest}`);
      return;
    }

    case 'doctor': {
      const bin = launcher.findFirefox();
      console.log(`firefox binary: ${bin || 'NOT FOUND (set FIREFOX_BIN)'}`);
      if (!bin) process.exitCode = 1;
      const st = await launcher.status();
      console.log(`port ${st.port}: ${st.reachable ? 'open' : 'closed'}`);
      console.log(`profile: ${st.profile}`);
      const { ToolHost } = require('../src/tools');
      const host = new ToolHost(options);
      console.log(`tools registered: ${host.tools().length}`);
      const session = await host.session();
      const tabId = await session.defaultTabId();
      console.log(`BiDi session: ok (${session.sessionId || 'existing session'})`);
      console.log(`user agent: ${await session.evaluate(tabId, 'navigator.userAgent')}`);
      console.log(`tabs: ${(await session.listTabs()).length}`);
      await host.close();
      console.log('All checks passed.');
      return;
    }

    case 'help':
    case '--help':
    case '-h':
      console.log(HELP);
      return;

    case 'version':
    case '--version':
      console.log(pkg.version);
      return;

    default:
      console.error(`unknown command: ${command}\n`);
      console.log(HELP);
      process.exitCode = 1;
  }
}

main().catch((err) => {
  console.error(`firefox-use: ${err.message}`);
  process.exit(1);
});
